# ==============================================================================
# The Hospital Portal — Environment Variables Template
# ==============================================================================

# Supabase Cloud Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Clinic Staff Passcode for /staff-portal gateway
NEXT_PUBLIC_STAFF_PASSCODE=APEX-STAFF-9021

# Supabase Service Role Secret (OPTIONAL: Only needed if running scripts/seed.mjs from terminal)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
